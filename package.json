        "ionic-serve": "ionic serve",
        "dev:ssr": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng run app:serve-ssr",
        "serve:ssr": "node dist/app/server/main.js",
        "build:ssr": "ng build && ng run app:server",
        "prebuild": "./prepare.sh",
        "prerender": "ng run app:prerender"
    },
